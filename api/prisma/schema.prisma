generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  password            String
  timezone            String               @default("UTC")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiInteractions      AIInteraction[]
  conversations       Conversation[]
  documents           Document[]
  embeddings          Embedding[]
  entityRelationships EntityRelationship[]
  goals               Goal[]
  habits              Habit[]
  journalEntries      JournalEntry[]
  lifeEntities        LifeEntity[]
  lifeEvents          LifeEvent[]
  memories            Memory[]
  observations        Observation[]
  tasks               Task[]
}

model LifeEntity {
  id                  String               @id @default(uuid())
  userId              String
  type                LifeEntityType
  name                String
  description         String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sourceRelationships EntityRelationship[] @relation("sourceEntity")
  targetRelationships EntityRelationship[] @relation("targetEntity")
  goals               Goal[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventsAtLocation    LifeEvent[]          @relation("eventLocation")
  observations        Observation[]

  @@index([userId])
  @@index([userId, type])
  @@index([userId, name])
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  mood      Int?
  energy    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Memory {
  id         String            @id @default(uuid())
  userId     String
  type       MemoryType
  content    String
  importance Float             @default(0.5)
  confidence Float             @default(0.5)
  sourceType MemorySourceType?
  sourceId   String?
  createdAt  DateTime          @default(now())
  expiresAt  DateTime?
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, expiresAt])
  @@index([sourceType, sourceId])
}

model EntityRelationship {
  id               String           @id @default(uuid())
  userId           String
  sourceEntityId   String
  targetEntityId   String
  relationshipType RelationshipType
  weight           Float            @default(1)
  confidence       Float            @default(0.5)
  metadata         Json?
  createdAt        DateTime         @default(now())
  sourceEntity     LifeEntity       @relation("sourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity     LifeEntity       @relation("targetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceEntityId, targetEntityId, relationshipType])
  @@index([userId, relationshipType])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

model Observation {
  id         String      @id @default(uuid())
  userId     String
  entityId   String?
  type       String
  value      Float
  unit       String?
  observedAt DateTime    @default(now())
  metadata   Json?
  entity     LifeEntity? @relation(fields: [entityId], references: [id])
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, observedAt])
  @@index([entityId, observedAt])
}

model Goal {
  id          String      @id @default(uuid())
  userId      String
  entityId    String?
  title       String
  description String?
  status      GoalStatus  @default(ACTIVE)
  priority    Int         @default(0)
  targetDate  DateTime?
  progress    Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entity      LifeEntity? @relation(fields: [entityId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId, status])
  @@index([entityId])
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  goalId      String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Int        @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  goal        Goal?      @relation(fields: [goalId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([goalId])
}

model Habit {
  id          String      @id @default(uuid())
  userId      String
  name        String
  description String?
  frequency   String
  target      Float?
  status      HabitStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@index([userId, status])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  completed Boolean  @default(false)
  value     Float?
  date      DateTime
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model LifeEvent {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  type        LifeEventType
  startAt     DateTime
  endAt       DateTime?
  locationId  String?
  createdAt   DateTime      @default(now())
  location    LifeEntity?   @relation("eventLocation", fields: [locationId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([locationId])
}

model Document {
  id         String          @id @default(uuid())
  userId     String
  name       String
  mimeType   String
  storageKey String
  status     DocumentStatus  @default(UPLOADING)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  Json?
  metadata   Json?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
}

model Embedding {
  id         String                @id @default(uuid())
  userId     String
  sourceType MemorySourceType
  sourceId   String
  content    String
  embedding  Unsupported("vector")
  metadata   Json?
  createdAt  DateTime              @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sourceType])
  @@index([sourceType, sourceId])
}

model AIInteraction {
  id             String            @id @default(uuid())
  userId         String
  conversationId String?
  model          String
  provider       String
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  status         String
  error          String?
  createdAt      DateTime          @default(now())
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources        SourceReference[]

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([provider, model])
}

model Conversation {
  id           String          @id @default(uuid())
  userId       String
  title        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  interactions AIInteraction[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SourceReference {
  id              String           @id @default(uuid())
  aiInteractionId String
  sourceType      MemorySourceType
  sourceId        String
  relevanceScore  Float?
  aiInteraction   AIInteraction    @relation(fields: [aiInteractionId], references: [id], onDelete: Cascade)

  @@index([aiInteractionId])
  @@index([sourceType, sourceId])
}

enum LifeEntityType {
  PERSON
  PLACE
  PROJECT
  GOAL
  HABIT
  EVENT
  ORGANIZATION
  SKILL
  TOPIC
  OBJECT
}

enum MemoryType {
  FACT
  PREFERENCE
  EXPERIENCE
  DECISION
  INSIGHT
  GOAL
  BELIEF
}

enum MemorySourceType {
  JOURNAL_ENTRY
  CONVERSATION
  LIFE_ENTITY
  EVENT
  MANUAL
  GOAL
  DOCUMENT
  ENTITY
}

enum RelationshipType {
  WORKED_ON
  KNOWS
  LIVES_IN
  VISITED
  RELATED_TO
  PART_OF
  CAUSED_BY
  LEADS_TO
  CONFLICTS_WITH
  SUPPORTS
  DEPENDS_ON
  ACHIEVED
  FAILED
  INSPIRED_BY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LifeEventType {
  JOB
  TRAVEL
  RELATIONSHIP
  EDUCATION
  ACHIEVEMENT
  FAILURE
  MILESTONE
  HEALTH
  PERSONAL
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}
